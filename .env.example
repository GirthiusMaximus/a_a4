# Copy to .env and edit. `cp .env.example .env`
# Compose reads .env for ${} interpolation automatically, and each service loads it as
# environment via env_file (that field needs Docker Compose 2.24 or newer; with an older
# version, export these in your shell before `docker compose up`).

# --- where things live inside the container ---------------------------------
DATA_DIR=/data
SKINS_DIR=/skins

# --- the dashboard ------------------------------------------------------------
HOST=0.0.0.0
PORT=8000
# Used to build links inside Discord posts. Set this to whatever the reviewer types
# into a browser, or the deep links from Discord will not open.
PUBLIC_BASE_URL=http://localhost:8000
# Who is recorded on a decision. This build has one reviewer and no login.
REVIEW_HOST=reviewer

# --- Steam -------------------------------------------------------------------
# Without a key the watcher cannot read the store, and /api/run/watch says so
# instead of showing you an empty rotation. Get one at steamcommunity.com/dev/apikey.
STEAM_API_KEY=
STEAM_APPID=252490
# Point at a JSON file of item records to run with no Steam access at all:
#   {"digest":"abc123","observedAt":"2026-10-03T12:00:00+00:00","items":[...]}
# A skin's itemdefid is also its workshop published-file id, which is what makes
# SKINS_DIR/<itemdefid> a valid lookup for the analyser.
STUB_CATALOG=

# --- loops -------------------------------------------------------------------
WATCH_INTERVAL_MIN=60
WATCH_ON_START=true
INGEST_LIMIT=50

# --- how close a hash has to be before it counts ------------------------------
# Crops are a specific shape in a specific place, so they get the looser number.
# A whole texture is one 8x9 summary of composition: two unrelated flat patterns
# sit 4 bits apart, which is why the texture number is tight.
LEDGER_CROP_MAX_DISTANCE=8
LEDGER_TEXTURE_MAX_DISTANCE=3

# --- Discord ------------------------------------------------------------------
# Leave the token empty and nothing leaves the container: posts are built, kept in
# the outbox table, and shown on the Outbox tab. That is a supported mode, not a
# broken state.
DISCORD_TOKEN=
# Channel ids, not names. The bot needs View Channel + Send Messages + Embed Links.
DISCORD_ROTATION_CHANNEL=
DISCORD_FLAG_CHANNEL=
BOT_INTERVAL_SEC=60
# Set true with a real token to build posts without sending them.
BOT_DRY_RUN=false
